# Build a patched copy, leaving the pinned SDL submodule and its gitlink intact.
# System SDL and non-Windows renderers retain their upstream source unchanged.
function(pui_sdl_d3d11_buffer_overlay)
  if(NOT WIN32 OR NOT TARGET SDL3-static OR NOT SDL_RENDER_D3D11)
    return()
  endif()
  set(original "${PROJECT_SOURCE_DIR}/vendored/SDL/src/render/direct3d11/SDL_render_d3d11.c")
  set(replacement "${PROJECT_SOURCE_DIR}/src/sdl_d3d11_buffer.inl")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${original}" "${replacement}")
  file(READ "${original}" source)
  string(REPLACE "\r\n" "\n" source "${source}")
  string(FIND "${source}" "static bool D3D11_UpdateVertexBuffer(SDL_Renderer *renderer," first)
  string(FIND "${source}" "static bool D3D11_UpdateViewport(SDL_Renderer *renderer)" last)
  if(first LESS 0 OR last LESS first)
    message(FATAL_ERROR "Pinned SDL D3D11 source changed; review the local buffer overlay")
  endif()
  math(EXPR length "${last} - ${first}")
  string(SUBSTRING "${source}" ${first} ${length} old_function)
  string(SHA256 old_hash "${old_function}")
  if(NOT old_hash STREQUAL "0c085faa13f86e57f6f605e6106718ebbf195b52c330b26c3a10fb2ba7bfd684")
    message(FATAL_ERROR "SDL D3D11 upload changed; review the buffer overlay (${old_hash})")
  endif()
  string(SUBSTRING "${source}" 0 ${first} prefix)
  string(SUBSTRING "${source}" ${last} -1 suffix)
  file(READ "${replacement}" function_source)
  set(generated "${CMAKE_CURRENT_BINARY_DIR}/pufferui-sdl/SDL_render_d3d11.c")
  file(CONFIGURE OUTPUT "${generated}" CONTENT "${prefix}${function_source}${suffix}" @ONLY)
  set_source_files_properties("${generated}" TARGET_DIRECTORY SDL3-static PROPERTIES
      INCLUDE_DIRECTORIES "${PROJECT_SOURCE_DIR}/src;${PROJECT_SOURCE_DIR}/vendored/SDL/src/render/direct3d11")
  get_target_property(sources SDL3-static SOURCES)
  set(found OFF)
  set(patched_sources)
  foreach(item IN LISTS sources)
    if(item MATCHES "(^|/)SDL_render_d3d11\\.c$")
      list(APPEND patched_sources "${generated}")
      set(found ON)
    else()
      list(APPEND patched_sources "${item}")
    endif()
  endforeach()
  if(NOT found)
    message(FATAL_ERROR "SDL D3D11 source is absent from SDL3-static")
  endif()
  set_property(TARGET SDL3-static PROPERTY SOURCES "${patched_sources}")
endfunction()
