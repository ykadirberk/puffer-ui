@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/pufferuiTargets.cmake")

# PufferUI is a header plus one implementation translation unit. Link
# `pufferui::pufferui` and add the implementation TU to exactly one target per
# binary:
#
#     find_package(pufferui CONFIG REQUIRED)
#     target_link_libraries(my_app PRIVATE pufferui::pufferui)
#     target_sources(my_app PRIVATE ${PUFFERUI_IMPL})
#
set(PUFFERUI_IMPL
    "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@/pufferui/pufferui_impl.cpp")

check_required_components(pufferui)
