@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
if(@PUFFERUI_WITH_SDL3@)
    find_dependency(SDL3 CONFIG)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/pufferuiTargets.cmake")

# Two prebuilt variants:
#
#   pufferui::pufferui  core only (backend-agnostic: tests, headless, engines)
#
# pufferui::sdl3 is exported when PUFFERUI_WITH_SDL3 was enabled; its SDL3
# dependency is found above. Core-only packages require no SDL installation.
#
# Prefer the single-TU distribution? PufferUI is still one header plus one
# implementation TU: add ${PUFFERUI_IMPL} to exactly one target per binary
# and define PUFFERUI_IMPLEMENTATION there.
#
#     find_package(pufferui CONFIG REQUIRED)
#     target_link_libraries(my_app PRIVATE pufferui::pufferui) # includes + core lib
#     # ...or, single-TU style (backend of your choice):
#     target_sources(my_app PRIVATE ${PUFFERUI_IMPL})
#
set(PUFFERUI_IMPL
    "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@/pufferui/pufferui_impl.cpp")

check_required_components(pufferui)
