#version 450
#extension GL_GOOGLE_include_directive : require
#include "bin_common.glsl"
#include "workgroup_scan.glsl"
layout(local_size_x=64) in;
void main() {
    uint lane=gl_LocalInvocationIndex;
    uint span=p.limits.w/64u+uint(p.limits.w%64u!=0u);
    uint first=lane*span,last=min(first+span,p.limits.w);
    uvec2 total=uvec2(0);
    for(uint tile=first;tile<last;++tile)
        total=bounded_sum(total,uvec2(work.words[tile],0),p.limits.z);
    uvec2 prefix=scan_partitions(total,p.limits.z);
    for(uint tile=first;tile<last;++tile) {
        work.words[p.limits.w+tile]=prefix.x;
        prefix=bounded_sum(prefix,uvec2(work.words[tile],0),p.limits.z);
    }
    if(lane==0u) {
        uvec2 sum=partition_prefix[63];
        work.words[p.limits.w*2u]=sum.x;
        control.words[3]=sum.y;
        control.words[0]=sum.y==0u?min(p.limits.w,p.grid.w):0u;
        control.words[1]=sum.y==0u?(p.limits.w+p.grid.w-1u)/p.grid.w:1u;
        control.words[2]=1u;
        control.words[4]=sum.x;
    }
}
