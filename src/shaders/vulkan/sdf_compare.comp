#version 450
#extension GL_GOOGLE_include_directive : require
#define PUI_SDF_PROGRAM
#include "bin_common.glsl"
#include "shape_common.glsl"
#include "sdf_history.glsl"
layout(local_size_x=64) in;
void hash_word(inout uvec2 h,uint v) { h=(h^uvec2(v))*uvec2(16777619u,2246822519u); }
void main() {
    uint tile=gl_GlobalInvocationID.x;
    if(tile>=p.limits.w) return;
    if(control.words[3]!=0u) {
        tile_state.words[tile]=1u;
        tile_state.words[p.limits.w+tile*2]=0u;
        tile_state.words[p.limits.w+tile*2+1]=0u;
        return; // an overflowing list must never be dereferenced, even for hashing
    }
    uint first=work.words[p.limits.w+tile],end=work.words[p.limits.w+tile+1];
    uvec2 h=uvec2(2166136261u,0x9e3779b9u);
    for(uint i=0;i<4;++i) hash_word(h,floatBitsToUint(p.clip[i]));
    hash_word(h,p.cache.y);hash_word(h,p.cache.z);
    for(uint at=first;at<end;++at) {
        PaintCommand c=tape.commands[output_list.values[at]];
        hash_word(h,c.header.x);hash_word(h,c.header.y);
        for(uint i=0;i<4;++i) hash_word(h,floatBitsToUint(c.bounds[i]));
        if(c.header.x==1u) {
            hash_word(h,c.payload.z);hash_word(h,c.payload.w);
            hash_word(h,c.identity.z);hash_word(h,c.identity.w);
        }
        if(c.header.x==2u) {
            Shape s=shapes.values[c.payload.z];
            for(uint i=0;i<4;++i) {
                hash_word(h,floatBitsToUint(s.bounds[i]));hash_word(h,floatBitsToUint(s.radii[i]));
                hash_word(h,floatBitsToUint(s.params[i]));hash_word(h,s.corners[i]);
            }
        }
    }
    if((p.cache.w&1u)!=0u) h=uvec2(0); // test-only collision injection
    tile_state.words[p.limits.w+tile*2]=h.x;
    tile_state.words[p.limits.w+tile*2+1]=h.y;
    bool equal_program=control.words[3]==0u && old_meta.words[0]!=0u &&
        old_meta.words[1+tile*2]==h.x && old_meta.words[2+tile*2]==h.y;
    uint base=1u+p.limits.w*2u;
    for(uint i=0;i<4;++i) equal_program=equal_program && old_meta.words[base+i]==floatBitsToUint(p.clip[i]);
    equal_program=equal_program && old_meta.words[base+4u]==p.cache.y && old_meta.words[base+5u]==p.cache.z;
    if(equal_program) {
        uint prev=old_work.words[p.limits.w+tile],prev_end=old_work.words[p.limits.w+tile+1];
        equal_program=(end-first)==(prev_end-prev);
        for(uint at=0;equal_program && at<end-first;++at)
            equal_program=same_command(tape.commands[output_list.values[first+at]],old_tape.commands[old_list.values[prev+at]]);
    }
    tile_state.words[tile]=equal_program?0u:1u;
    atomicAdd(control.words[equal_program?7:5],1u);
}
