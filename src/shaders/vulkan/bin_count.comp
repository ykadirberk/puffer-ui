#version 450
#extension GL_GOOGLE_include_directive : require
#include "bin_common.glsl"
layout(local_size_x=64) in;
void main() {
    uint tile = gl_GlobalInvocationID.x;
    if (tile >= p.limits.w) return;
    uint first = coarse_base(tile), count = 0;
    for (uint word=0; word<p.limits.y; ++word) {
        uint bits = coarse_bits.words[first+word];
        while (bits != 0) {
            uint id = word*32+uint(findLSB(bits));
            bits &= bits-1;
            if (id < p.limits.x && intersects_tile(id,tile)) ++count;
        }
    }
    work.words[tile] = count;
}
