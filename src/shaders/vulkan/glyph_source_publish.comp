#version 450
#extension GL_GOOGLE_include_directive : require
#include "glyph_source_requests.glsl"
layout(local_size_x=64) in;
void main() {
    uint index=gl_GlobalInvocationID.x;
    if(index>=source_parameters.value.x) return;
    uvec4 key=requests.values[index].key;
    imageStore(glyph_output,ivec2(0,int(key.x)*65),uvec4(key.y));
    imageStore(glyph_output,ivec2(1,int(key.x)*65),uvec4(key.z));
}
