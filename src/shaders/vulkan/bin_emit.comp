#version 450
#extension GL_GOOGLE_include_directive : require
#include "bin_common.glsl"
layout(local_size_x=64) in;
void main() {
    uint tile = gl_GlobalInvocationID.x;
    if (tile >= p.limits.w || atomicAdd(control.words[3],0) != 0) return;
    uint first = coarse_base(tile);
    uint at = work.words[p.limits.w+tile];
    uint end = work.words[p.limits.w+tile+1];
    for (uint word=0; word<p.limits.y; ++word) {
        uint bits = coarse_bits.words[first+word];
        while (bits != 0) {
            uint id = word*32+uint(findLSB(bits));
            bits &= bits-1;
            if (id < p.limits.x && intersects_tile(id,tile)) {
                if (at >= end || at >= p.limits.z) {
                    atomicOr(control.words[3],2);
                    return;
                }
                output_list.values[at++] = id;
            }
        }
    }
    if (at != end) atomicOr(control.words[3],2);
}
