#version 450
#extension GL_GOOGLE_include_directive : require
#define PUI_SDF_PROGRAM
#include "bin_common.glsl"
#include "shape_common.glsl"
#include "sdf_history.glsl"
#include "workgroup_scan.glsl"
layout(local_size_x=64) in;
void main() {
    uint lane=gl_LocalInvocationIndex;
    uint span=p.limits.w/64u+uint(p.limits.w%64u!=0u);
    uint first=lane*span,last=min(first+span,p.limits.w);
    uint count=0;
    if(control.words[3]==0u)
        for(uint tile=first;tile<last;++tile)
            count+=uint(tile_state.words[tile]!=0u);
    uint at=scan_partitions(uvec2(count,0),p.limits.w).x;
    if(control.words[3]==0u)
        for(uint tile=first;tile<last;++tile)
            if(tile_state.words[tile]!=0u) tile_state.words[p.limits.w*3u+at++]=tile;
    if(lane==0u) {
        uint total=partition_prefix[63].x;
        control.words[0]=min(total,p.grid.w);
        control.words[1]=total/p.grid.w+uint(total%p.grid.w!=0u);
        control.words[2]=1u;
    }
}
