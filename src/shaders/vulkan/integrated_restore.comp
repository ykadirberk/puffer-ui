#version 450
#extension GL_GOOGLE_include_directive : require
#define PUI_SDF_PROGRAM
#include "bin_common.glsl"
#include "shape_common.glsl"
#include "sdf_history.glsl"
layout(rgba8,set=2,binding=0) uniform writeonly image2D scene;
layout(std430,set=1,binding=2) buffer Route { uint words[]; } route;
layout(local_size_x=8,local_size_y=8) in;
shared uint group_pixels;
void main() {
    uint tile=gl_WorkGroupID.x+gl_WorkGroupID.y*gl_NumWorkGroups.x;
    if(tile>=p.limits.w || control.words[3]!=0u || tile_state.words[tile]!=0u) return;
    if(gl_LocalInvocationIndex==0u) group_pixels=0u;
    barrier();
    uint count=0u;
    uvec2 origin=uvec2(tile%p.grid.x,tile/p.grid.x)*p.extent.z;
    for(uint y=gl_LocalInvocationID.y;y<p.extent.z;y+=8u)
        for(uint x=gl_LocalInvocationID.x;x<p.extent.z;x+=8u) {
            uvec2 pixel=origin+uvec2(x,y);
            if(any(greaterThanEqual(pixel,p.extent.xy))) continue;
            uint at=pixel.y*p.extent.x+pixel.x;
            atomicOr(route.words[at>>5],1u<<(at&31u));
            imageStore(scene,ivec2(pixel),imageLoad(saved_pixels,ivec2(pixel)));
            ++count;
        }
    if(count!=0u) atomicAdd(group_pixels,count);
    barrier();
    if(gl_LocalInvocationIndex==0u) atomicAdd(control.words[8],group_pixels);
}
